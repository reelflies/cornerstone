{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/release.sh *)",
      "Bash(./scripts/release.sh *)",
      "Bash(scripts/merge.sh *)",
      "Bash(./scripts/merge.sh *)",
      "Bash(node scripts/store/*)",
      "Bash(node scripts/status.mjs *)"
    ],
    "deny": [
      "Bash(npx stencil push*)",
      "Bash(stencil push*)",
      "Bash(npx @bigcommerce/stencil-cli push*)",
      "Bash(npm exec stencil push*)",
      "Bash(npm exec -- stencil push*)",
      "Bash(*node_modules/.bin/stencil push*)",
      "Bash(npx stencil release*)",
      "Bash(stencil release*)",
      "Bash(gh pr merge*)",
      "Bash(gh * pr merge*)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(git push * master)",
      "Bash(git push * master *)",
      "Bash(git push *:master)",
      "Bash(git push *:master *)",
      "Bash(git push *:refs/heads/master*)",
      "Bash(curl* -X*api.bigcommerce.com*)",
      "Bash(curl*api.bigcommerce.com* -X*)",
      "Bash(curl* --request*api.bigcommerce.com*)",
      "Bash(curl*api.bigcommerce.com* --request*)",
      "Bash(curl* -d*api.bigcommerce.com*)",
      "Bash(curl*api.bigcommerce.com* -d*)",
      "Bash(curl* --data*api.bigcommerce.com*)",
      "Bash(curl*api.bigcommerce.com* --data*)",
      "Bash(curl* --json*api.bigcommerce.com*)",
      "Bash(curl*api.bigcommerce.com* --json*)",
      "Bash(curl* -F*api.bigcommerce.com*)",
      "Bash(curl*api.bigcommerce.com* -F*)",
      "Bash(curl* --form*api.bigcommerce.com*)",
      "Bash(curl*api.bigcommerce.com* --form*)",
      "Bash(curl* -T*api.bigcommerce.com*)",
      "Bash(curl*api.bigcommerce.com* -T*)",
      "Bash(curl* --upload-file*api.bigcommerce.com*)",
      "Bash(curl*api.bigcommerce.com* --upload-file*)",
      "Bash(security find-generic-password*)",
      "Bash(security find-internet-password*)",
      "Bash(security dump-keychain*)",
      "Bash(cat *secrets.stencil.json*)",
      "Bash(head *secrets.stencil.json*)",
      "Bash(tail *secrets.stencil.json*)",
      "Bash(less *secrets.stencil.json*)",
      "Bash(cp *secrets.stencil.json*)",
      "Bash(cat *reelflies/.env*)",
      "Bash(head *reelflies/.env*)",
      "Bash(tail *reelflies/.env*)",
      "Bash(less *reelflies/.env*)",
      "Bash(cp *reelflies/.env*)",
      "Bash(cat *.config/reelflies/*)",
      "Bash(head *.config/reelflies/*)",
      "Bash(tail *.config/reelflies/*)",
      "Bash(less *.config/reelflies/*)",
      "Bash(cp *.config/reelflies/*)",
      "Read(**/secrets.stencil.json)",
      "Read(~/reelflies/**/secrets.stencil.json)",
      "Read(~/.config/reelflies/**)",
      "Read(~/reelflies/.env)",
      "Read(~/reelflies/report/data/orders_cache.json)",
      "Read(~/reelflies/**/pull.log)"
    ]
  }
}
